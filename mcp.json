{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agentcontinuity": {
      "type": "streamable-http",
      "url": "https://api.agentcontinuity.net/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://api.agentcontinuity.net/mcp/openai",
            "baseScopes": [
              "memory:read"
            ]
          }
        }
      }
    }
  }
}
